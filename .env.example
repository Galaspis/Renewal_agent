# Shared family password for the dashboard login.
FAMILY_PASSWORD=changeme

# Long random string used to sign the login cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Optional. Used in alert emails so "Open in dashboard" points somewhere useful.
APP_URL=http://localhost:3000

# Who alerts are sent from / to. You can also set recipients in Settings.
ALERT_FROM_EMAIL=Renewal <renewal@localhost>
ALERT_TO_EMAIL=

# Optional. If set, alerts are sent through Resend.
RESEND_API_KEY=

# Optional. Used when RESEND_API_KEY is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional. Direct inbound mail via Resend Receiving: the address renewal emails are forwarded to,
# and the signing secret of the Resend webhook that points at /api/inbound (or paste it in Settings).
INBOUND_ADDRESS=
RESEND_WEBHOOK_SECRET=

# Optional. AI to fill drafts from mail. Claude is the most accurate for this.
# Paste in Settings, or here:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# claude | openai | gemini | auto
AI_PROVIDER=auto

# Optional. Lets a scheduler call /api/cron/alerts without logging in.
CRON_SECRET=

# On the gallab server only: trust the hub login (Caddy + Tinyauth) and skip the family password.
HUB_AUTH=0
